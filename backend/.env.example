ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_SCHEMA=invoice_breakdown
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional classification. Use a model compatible with strict structured outputs.
# Configure only with an approved account for processing workbook evidence.
# CLASSIFICATION_MODEL=
# CLASSIFICATION_SKILL_PATH=/path/to/approved/SKILL.md
# Optional pinned supplementary rules.
# CLASSIFICATION_CODEX_PATH=/path/to/approved/Invoice.Breakdown.Codex.md
# LLM_API_KEY=

# Local trusted Docker runtime with a prebuilt isolated QA worker image.
# QA_WORKER_IMAGE=invoice-breakdown-qa:local
# QA_DOCKER_RUNTIME=docker

# Optional task API configuration. Set one generated bearer token per operator
# in your private .env or deployment secret. Never commit actual token values.
# OPERATOR_TOKENS={"operator-a":"<generate-a-32-character-or-longer-token>"}
# Local development only. Use an absolute directory or a persistent Docker volume.
# SOURCE_STORAGE_DIRECTORY=/path/to/private/source-files
# Azure deployment uses AZURE_STORAGE_BLOB_ENDPOINT, the private
# AZURE_STORAGE_DOCUMENTS_CONTAINER, and the existing AZURE_CLIENT_ID.
